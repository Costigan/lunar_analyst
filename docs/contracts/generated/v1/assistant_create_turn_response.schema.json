          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "user_message_id": {
          "title": "User Message Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AssistantTurnStatus"
