    "confirmation": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssistantConfirmation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tool_calls": {
      "items": {
        "$ref": "#/$defs/AssistantToolCall"
      },
      "title": "Tool Calls",
      "type": "array"
    }
  },
  "required": [
    "turn"
  ],
  "title": "CreateAssistantTurnResponse",
  "type": "object"
}