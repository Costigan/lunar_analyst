        "file_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Id"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "output_id",
        "kind",
        "mime_type",
        "storage"
      ],
      "title": "AssistantOutput",
      "type": "object"
    },
    "AssistantRole": {
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
