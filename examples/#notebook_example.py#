# -----------------------------------------------------------------
# Preload correct shared-library versions BEFORE any GDAL import.
#
# Two SONAME collisions exist between the system-installed GDAL
# libraries and the moonlib-bundled ones:
#
#   libtiff.so.6  – system v4.5.1  vs. moonlib (needs LIBTIFF_4.6.1)
#   libxml2.so.2  – system v2.9.14 vs. moonlib (missing xmlNanoHTTPCleanup)
#
# .NET GDAL (moonlib) requires the newer libtiff, while Python GDAL's
# libspatialite requires the newer (system) libxml2.  Preload the
# "right" version of each before any dlopen can load the wrong one.
# The libxml2 preload is also handled inside configure_gdal_runtime(),
# but the libtiff preload must happen first, before that call.
# -----------------------------------------------------------------


def _find_moonlib_linux_dir() -> Path | None:
    """Return the linux-x64 output directory inside moonlib's build tree."""
    moonlib_project = repo_root / "native" / "new_horizon" / "moonlib"
    if not moonlib_project.is_dir():
        return None
    candidates = sorted(
        moonlib_project.glob("bin/*/net*/linux-x64"), reverse=True
    )
    for d in candidates:
        if (d / "libtiff.so.6").exists():
            return d
    return None


_moonlib_dir = _find_moonlib_linux_dir()
if _moonlib_dir is not None:
    ctypes.CDLL(str(_moonlib_dir / "libtiff.so.6"))
