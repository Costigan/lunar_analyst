def example_transform(tile_3d: np.ndarray) -> np.ndarray:
    """
    Example tile transform: computes the mean over the time axis.
    Input shape: [time, height, width]
    Output shape: [height, width]
    """
    # Compute mean and normalize if necessary
    tile_2d = tile_3d.mean(axis=0, dtype=np.float32)

    # Example normalization: assuming input is uint8 (0-255)
    tile_2d = (tile_2d / 255.0).astype(np.float32, copy=False)

    return tile_2d


