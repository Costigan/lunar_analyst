<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8600</NoWarn>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaxRev.Gdal.Core" Version="3.11.3.339" />
    <PackageReference Include="MaxRev.Gdal.LinuxRuntime.Minimal" Version="3.11.3.339" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\moonlib\moonlib.csproj" />
  </ItemGroup>

</Project>
